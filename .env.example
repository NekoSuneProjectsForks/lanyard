# Copy to .env and fill in. docker compose reads this file automatically.

# --- required ----------------------------------------------------------------
# Discord bot token: https://discord.com/developers/applications
# Enable PRESENCE INTENT and SERVER MEMBERS INTENT on the bot.
BOT_TOKEN=

# --- the one published port ---------------------------------------------------
PORT=4001
EXTERNAL_URL=http://localhost:4001
COMMAND_PREFIX=.

# --- redis --------------------------------------------------------------------
# Leave REDIS_URL unset to use the Redis bundled in the image (persists to /data).
# Set it to use your own, and the bundled one is not started.
#
#   redis://<user>:<password>@<host>:<port>/<db>
#
# "default" is Redis 6+'s built-in ACL user - the one a plain `requirepass`
# password authenticates as. Use rediss:// instead of redis:// for TLS, and
# percent-encode any @ : / characters in the password.
#
# REDIS_URL=redis://default:YOUR_PASSWORD@127.0.0.1:6379/0
#
# No password at all:
# REDIS_URL=redis://127.0.0.1:6379/0
REDIS_URL=

# Set to true if your Redis host resolves over IPv6.
REDIS_IPV6=false

# --- optional services --------------------------------------------------------
# Turn any of these off without rebuilding the image.
ENABLE_GRAPHQL=true
ENABLE_README=true
ENABLE_MCP=true
