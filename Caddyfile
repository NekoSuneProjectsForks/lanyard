# Single entrypoint for the all-in-one image. Every service in the container is
# bound to loopback; this is the only listener that is published.
#
#   /graphql   -> packages/graphql        (Apollo Server)
#   /readme    -> packages/profile-readme (Next.js)
#   /mcp       -> packages/mcp-server     (MCP over streamable HTTP)
#   everything else -> the Lanyard API and WebSocket
#
# The core API stays mounted at the root so /v1/users/:id, /socket and the
# quicklink routes keep the exact paths they have on the public instance.
#
# Ports come from the environment so docker/entrypoint.sh stays the one place
# that decides them.

{
	admin off
	auto_https off
}

:{$LISTEN_PORT:4001} {
	handle_path /graphql* {
		reverse_proxy 127.0.0.1:{$GRAPHQL_PORT:8080}
	}

	handle /readme* {
		reverse_proxy 127.0.0.1:{$README_PORT:3000}
	}

	handle /mcp* {
		reverse_proxy 127.0.0.1:{$MCP_PORT:8081}
	}

	handle {
		reverse_proxy 127.0.0.1:{$API_PORT:4010}
	}
}
